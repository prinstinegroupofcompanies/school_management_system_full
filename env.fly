APP_NAME="School Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://school-management-system.fly.dev

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# SQLite Database Configuration for Fly.io
DB_CONNECTION=sqlite
DB_DATABASE=/database/school_management.sqlite

# Cache and Session Configuration
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120

# Redis Configuration (not used in free tier)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration (using log driver for free tier)
MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@school-management-system.fly.dev"
MAIL_FROM_NAME="${APP_NAME}"

# AWS Configuration (optional for file uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher Configuration (optional for real-time features)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Vite Configuration
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# SMS Configuration (optional)
SMS_DRIVER=log
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Currency and Locale
CURRENCY=LRD
LOCALE=en
TIMEZONE=Africa/Monrovia

# File Upload Settings
MAX_FILE_SIZE=10240
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx,mp4,mp3

# Backup Settings
BACKUP_ENABLED=false
BACKUP_RETENTION_DAYS=30
